[Unit]
Description=Chat Application API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chat-app/chat-api
EnvironmentFile=/etc/chat-api.env
ExecStart=/usr/bin/node /opt/chat-app/chat-api/src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/chat-app

[Install]
WantedBy=multi-user.target
